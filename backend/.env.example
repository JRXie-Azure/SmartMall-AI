# ====== SmartMall-AI 环境配置模板 ======
# 复制为 .env 后修改实际值

# ------ 应用模式 ------
ENV=development
DEBUG=true

# ------ 应用信息 ------
APP_NAME=SmartMall AI
APP_VERSION=2.0.0

# ------ 数据库 ------
# 开发: sqlite:///./smartmall.db
# 生产: mysql+pymysql://root:password@localhost:3306/smartmall?charset=utf8mb4
# MySQL 部署: docker-compose -f docker-compose.dev.yml up -d
# 迁移命令: alembic upgrade head
DATABASE_URL=sqlite:///./smartmall.db

# ------ Redis 缓存 ------
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRE_SECONDS=300

# ------ JWT 认证 (生产务必更换) ------
# 生成: openssl rand -hex 32
SECRET_KEY=your-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ------ CORS ------
# 开发用 *，生产改为具体域名
CORS_ORIGINS=*

# ------ API 限流 ------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AI_REQUESTS=20

# ------ 文件上传 ------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ------ DeepSeek LLM (可选) ------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------ 文件存储 ------
# local = 本地存储 (开发) | s3 = 对象存储 (生产)
STORAGE_TYPE=local

# 对象存储配置
# S3_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
# S3_REGION=cn-shenzhen
# S3_PUBLIC_URL=https://your-cdn-domain.com

# ------ 支付 (可选) ------
# WXPAY_APPID=
# WXPAY_MCHID=
# WXPAY_API_V3_KEY=
# WXPAY_CERT_SERIAL_NO=
# WXPAY_PRIVATE_KEY_PATH=./certs/wxpay/apiclient_key.pem
# WXPAY_NOTIFY_URL=https://yourdomain.com/api/payment/wxpay/notify
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_PATH=./certs/alipay/app_private_key.pem
# ALIPAY_PUBLIC_KEY_PATH=./certs/alipay/alipay_public_key.pem
# ALIPAY_NOTIFY_URL=https://yourdomain.com/api/payment/alipay/notify
# ALIPAY_RETURN_URL=https://yourdomain.com/orders
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_SANDBOX=true
